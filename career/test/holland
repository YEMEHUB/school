    <div class="result" id="resultBox">
      <h2>검사 결과</h2>
      <div class="result-codes" id="topTypes"></div>
      <div id="typeTags"></div>

      <table class="scores-table" id="scoresTable">
        <thead>
          <tr>
            <th>유형</th>
            <th>R</th>
            <th>I</th>
            <th>A</th>
            <th>S</th>
            <th>E</th>
            <th>C</th>
          </tr>
        </thead>
        <tbody>
          <tr id="scoreRow">
            <td>점수</td>
            <td id="scoreR"></td>
            <td id="scoreI"></td>
            <td id="scoreA"></td>
            <td id="scoreS"></td>
            <td id="scoreE"></td>
            <td id="scoreC"></td>
          </tr>
        </tbody>
      </table>

      <div id="typeDescription"></div>
      <p class="note">
        • 상위 2개 유형 조합(예: <strong>RI, AS</strong>)으로 보는 것이 더 정확합니다.<br/>
        • 이 검사는 수업용 간이 검사이며, 진로 탐색 참고 자료로 활용해 주세요.
      </p>
    </div>

    <div class="footer-note">
      ※ 이 페이지는 중·고등학생 수업용으로 제작된 비공식 Holland 흥미유형 간이검사입니다.
    </div>
  </div>

  <script>
    const typeInfo = {
      R: {
        name: "R형 현실형 (Realistic)",
        tagClass: "type-R",
        desc: "손으로 만들기, 조립, 실습, 기계·도구 다루기 등 실제 활동을 좋아하는 유형입니다. 공학, 기계, 전기·전자, 건설, 자동차, 항공, 농생명, 스포츠 관련 분야와 잘 어울리는 경우가 많습니다."
      },
      I: {
        name: "I형 탐구형 (Investigative)",
        tagClass: "type-I",
        desc: "분석, 탐구, 연구, 실험, 문제 해결을 좋아하는 유형입니다. 과학, 수학, 데이터, 의·약학, 소프트웨어, AI·데이터사이언스, 통계 등과 잘 어울리는 경우가 많습니다."
      },
      A: {
        name: "A형 예술형 (Artistic)",
        tagClass: "type-A",
        desc: "창의적 표현, 예술, 디자인, 글쓰기, 음악, 영상, 공연 등을 좋아하는 유형입니다. 미술·디자인, 음악, 영상·미디어, 문예창작, 콘텐츠 제작, 게임 그래픽 등과 잘 어울립니다."
      },
      S: {
        name: "S형 사회형 (Social)",
        tagClass: "type-S",
        desc: "사람을 돕고, 가르치고, 상담하고, 함께 활동하는 것을 좋아하는 유형입니다. 교육, 상담·심리, 사회복지, 간호·보건, 코칭, 봉사 관련 진로와 잘 맞는 경우가 많습니다."
      },
      E: {
        name: "E형 진취형 (Enterprising)",
        tagClass: "type-E",
        desc: "목표 설정, 기획, 리더십, 설득, 발표, 조직을 이끄는 일을 좋아하는 유형입니다. 경영·경제, 마케팅, 스타트업, 정치·행정, 홍보, 기획·PM 직무 등과 잘 어울립니다."
      },
      C: {
        name: "C형 관습형 (Conventional)",
        tagClass: "type-C",
        desc: "체계적, 꼼꼼함, 정리·정돈, 규칙, 자료 관리, 문서 작업 등을 선호하는 유형입니다. 회계·재무, 사무·행정, 기록·문헌정보, 통계, 데이터 관리, 공공기관 사무 등과 잘 맞는 경우가 많습니다."
      }
    };

    function calculateScores() {
      const answers = {};
      for (let i = 1; i <= 24; i++) {
        const name = "q" + i;
        const selected = document.querySelector(`input[name="${name}"]:checked`);
        if (!selected) {
          alert(i + "번 문항에 답을 선택해 주세요.");
          return null;
        }
        answers[name] = Number(selected.value);
      }

      const scores = {
        R: answers.q1 + answers.q2 + answers.q3 + answers.q4,
        I: answers.q5 + answers.q6 + answers.q7 + answers.q8,
        A: answers.q9 + answers.q10 + answers.q11 + answers.q12,
        S: answers.q13 + answers.q14 + answers.q15 + answers.q16,
        E: answers.q17 + answers.q18 + answers.q19 + answers.q20,
        C: answers.q21 + answers.q22 + answers.q23 + answers.q24
      };

      return scores;
    }

    function showResult(scores) {
      const resultBox = document.getElementById("resultBox");
      const scoreR = document.getElementById("scoreR");
      const scoreI = document.getElementById("scoreI");
      const scoreA = document.getElementById("scoreA");
      const scoreS = document.getElementById("scoreS");
      const scoreE = document.getElementById("scoreE");
      const scoreC = document.getElementById("scoreC");

      scoreR.textContent = scores.R;
      scoreI.textContent = scores.I;
      scoreA.textContent = scores.A;
      scoreS.textContent = scores.S;
      scoreE.textContent = scores.E;
      scoreC.textContent = scores.C;

      const arr = Object.entries(scores).map(([code, score]) => ({ code, score }));
      arr.sort((a, b) => b.score - a.score);

      const top1 = arr[0];
      const top2 = arr[1];

      const topTypesText = document.getElementById("topTypes");
      topTypesText.textContent = `당신의 상위 흥미 유형: ${top1.code} / ${top2.code} (예: ${top1.code}${top2.code}형)`;

      const typeTagsDiv = document.getElementById("typeTags");
      typeTagsDiv.innerHTML = "";
      arr.forEach(item => {
        const span = document.createElement("span");
        span.className = "type-tag " + typeInfo[item.code].tagClass;
        span.textContent = `${item.code}: ${item.score}점`;
        typeTagsDiv.appendChild(span);
      });

      const descDiv = document.getElementById("typeDescription");
      const info1 = typeInfo[top1.code];
      const info2 = typeInfo[top2.code];

      descDiv.innerHTML = `
        <p><strong>상위 1유형: ${info1.name}</strong><br>${info1.desc}</p>
        <p><strong>상위 2유형: ${info2.name}</strong><br>${info2.desc}</p>
        <p style="font-size:0.85rem; margin-top:8px;">
          👉 예를 들어, <strong>${top1.code}${top2.code}</strong> 조합이라면 두 유형의 특징을 함께 고려하여
          진로 계열·학과를 탐색해 볼 수 있습니다.
        </p>
      `;

      resultBox.style.display = "block";
      resultBox.scrollIntoView({ behavior: "smooth" });
    }

    document.getElementById("calcBtn").addEventListener("click", function() {
      const scores = calculateScores();
      if (!scores) return;
      showResult(scores);
    });
  </script>
</body>
</html>
